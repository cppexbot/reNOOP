{
  "sourceLanguage" : "en",
  "strings" : {
    "CFBundleDisplayName" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NOOP"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NOOP"
          }
        }
      }
    },
    "NSAlarmKitUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NOOP sets a system alarm as the phone’s backup to your strap’s silent wake."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NOOP ставит системный будильник как запасной к беззвучной вибрации браслета."
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NOOP connects to your WHOOP strap to read heart rate, HRV and battery on this iPhone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NOOP подключается к браслету WHOOP, чтобы считывать пульс, ВСР и заряд батареи на этом iPhone."
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NOOP reads your Apple Health data to compute Charge, Effort and sleep on this iPhone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NOOP читает данные приложения «Здоровье», чтобы рассчитывать Заряд, Усилие и сон на этом iPhone."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NOOP saves the metrics it computes from your strap to Apple Health."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NOOP сохраняет показатели, рассчитанные по данным браслета, в приложение «Здоровье»."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NOOP records your route during outdoor workouts, also with the screen off, to show distance, pace and a map."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NOOP записывает маршрут на тренировках на улице, в том числе при выключенном экране, чтобы показать дистанцию, темп и карту."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NOOP uses the microphone so you can ask the coach a question by voice."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NOOP использует микрофон, чтобы вопрос тренеру можно было задать голосом."
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NOOP reads your iPhone’s step count to show steps for walking and running workouts."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NOOP считывает шаги iPhone, чтобы показывать их на тренировках ходьбой и бегом."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NOOP transcribes your question on this iPhone so you can ask the coach out loud."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NOOP распознаёт вопрос на этом iPhone, чтобы его можно было задать тренеру голосом."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
